    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
    <!-- 直接連結正式資料、採樣及繪圖程式；不讀 OAuth 帳號。 -->
    <Compile Include="../AIClockBridge/Pc*.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="../AIClockBridge/GpuStatsReader.cs" Link="GpuStatsReader.cs" />
    <Compile Include="../AIClockBridge/SystemStatsMonitor.cs" Link="SystemStatsMonitor.cs" />
    <Compile Include="../AIClockBridge/MiniHttpServer.cs" Link="MiniHttpServer.cs" />
  </ItemGroup>
</Project>
